---
import "@fontsource-variable/noto-sans-sc";
import "@fontsource-variable/space-grotesk";
import "../styles/global.css";
import { Header, Brand } from "../components/header";
import { SelectionTray } from "../components/selection";
import { getProducts } from "../data/catalog";
import { withBase } from "../lib/paths";
interface Props { title?: string; description?: string; noindex?: boolean }
const { title, description = "查酷态科产品参数、对比型号、查看价格记录和选购资料，找到适合自己设备的充电装备。", noindex = false } = Astro.props;
const pageTitle = title ? `${title} · CukWise` : "CukWise · 酷态科选购指南";
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const products = getProducts();
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {noindex && <meta name="robots" content="noindex,follow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}icon.svg`} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <Header products={products} path={Astro.url.pathname} client:load />
    <main id="main" class="container main-content"><slot /></main>
    <footer class="site-footer container">
      <div class="footer-brand"><a href={withBase("/")} aria-label="CukWise 首页"><Brand /></a><p>选好充电装备，从了解它开始。</p></div>
      <div class="footer-links"><a href={withBase("/about")}>关于本站</a><a href={withBase("/privacy")}>隐私说明</a><a href={withBase("/insights")}>选购资料</a></div>
      <div class="footer-meta">
        <span>© {new Date().getFullYear()} CukWise · 独立运营的酷态科选购指南</span>
        {import.meta.env.PUBLIC_OPERATOR_NAME && <span>运营：{import.meta.env.PUBLIC_OPERATOR_NAME}</span>}
        {import.meta.env.PUBLIC_ICP_NUMBER && <a href="https://beian.miit.gov.cn/" target="_blank" rel="noreferrer">{import.meta.env.PUBLIC_ICP_NUMBER}</a>}
        {import.meta.env.PUBLIC_POLICE_NUMBER && import.meta.env.PUBLIC_POLICE_CODE && <a href={`https://beian.mps.gov.cn/#/query/webSearch?code=${encodeURIComponent(import.meta.env.PUBLIC_POLICE_CODE)}`} target="_blank" rel="noreferrer">{import.meta.env.PUBLIC_POLICE_NUMBER}</a>}
      </div>
    </footer>
    <SelectionTray products={products} client:load />
  </body>
</html>
