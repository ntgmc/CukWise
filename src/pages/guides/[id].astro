---
import Layout from "../../layouts/Layout.astro";
import { guides } from "../../data/guides";
import { getProduct } from "../../data/catalog";
import { withBase } from "../../lib/paths";
import { dateLabel } from "../../lib/domain";
export function getStaticPaths() {
  return guides.map(guide => ({ params: { id: guide.id }, props: { guide } }));
}
const { guide } = Astro.props;
const picks = guide.picks.map(pick => ({ ...pick, product: getProduct(pick.productId)! }));
---
<Layout title={guide.title} description={guide.summary}>
  <a class="back-link" href={withBase("/insights")}>← 返回选购指南</a>
  <article class="guide-article">
    <header class="guide-heading"><span class="badge badge-green">站内选购指南</span><h1>{guide.title}</h1><p>{guide.summary}</p><small>核对于 {dateLabel(guide.updatedAt)} · 按官方规格与具名来源整理</small></header>
    <div class="guide-layout"><div class="prose guide-prose">
      {guide.sections.map(section => <section><h2>{section.title}</h2>{section.paragraphs.map(paragraph => <p>{paragraph}</p>)}</section>)}
      <section><h2>从这些型号开始比较</h2><div class="guide-picks">{picks.map(pick => <a href={withBase(`/products/${pick.product.id}`)}><img src={`${import.meta.env.BASE_URL}${pick.product.image}`} alt={pick.product.name} width="120" height="90" loading="lazy"/><span><strong>{pick.product.name}</strong><small>{pick.reason}</small></span><span aria-hidden="true">↗</span></a>)}</div></section>
      <section class="guide-sources"><h2>来源与进一步阅读</h2><p>参数以具体型号和实物版本为准。评测数值对应原文的设备、接口与测试条件。</p><ul>{guide.sources.map(source => <li><a href={source.url} target="_blank" rel="noreferrer">{source.label} ↗</a></li>)}</ul></section>
    </div><aside class="guide-checklist"><h2>下单前核对</h2><ul>{guide.checklist.map(item => <li>{item}</li>)}</ul><a class="button button-dark" href={withBase(`/compare?ids=${picks.map(pick => pick.product.id).join(",")}`)}>对比文中型号 ↗</a><a class="text-link" href={withBase(`/products?category=${guide.categoryIds[0]}`)}>浏览同类产品 →</a></aside></div>
  </article>
</Layout>
